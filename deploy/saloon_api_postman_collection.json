{
  "info": {
    "name": "Jugnu Saloon Public API",
    "description": "Postman collection for Jugnu Saloon public REST API endpoints (Products, Services, Categories, Gallery Showcase, Appointment Booking, Contact Form, Customer Signup & Login)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Fetch Products Catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/products?search=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Services Catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/services?category_id=&search=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "services"
          ],
          "query": [
            {
              "key": "category_id",
              "value": "",
              "disabled": true
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "Fetch Service Categories",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/service-categories",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "service-categories"
          ]
        }
      }
    },
    {
      "name": "Fetch Gallery Showcase",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/galleries?category=&search=",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "galleries"
          ],
          "query": [
            {
              "key": "category",
              "value": "",
              "disabled": true
            },
            {
              "key": "search",
              "value": "",
              "disabled": true
            }
          ]
        }
      }
    },
    {
      "name": "Book Appointment",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Ayesha Khan\",\n  \"customer_phone\": \"03194415757\",\n  \"customer_email\": \"ayesha@example.com\",\n  \"appointment_date\": \"2026-08-20\",\n  \"start_time\": \"14:00\",\n  \"service_ids\": [1, 2],\n  \"notes\": \"Requested senior stylist.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/appointments",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "appointments"
          ]
        }
      }
    },
    {
      "name": "Submit Contact Form",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Jane Smith\",\n  \"email\": \"jane@example.com\",\n  \"phone\": \"03009876543\",\n  \"subject\": \"General Inquiry\",\n  \"message\": \"I would like to inquire about wedding hair packages.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/contact",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "contact"
          ]
        }
      }
    },
    {
      "name": "Customer Account Signup",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Sarah Johnson\",\n  \"phone_no1\": \"03123456789\",\n  \"username\": \"sarah_j\",\n  \"password\": \"password123\",\n  \"father_name\": \"Robert Johnson\",\n  \"address\": \"123 Beauty Ave, Lahore\",\n  \"card_type\": \"Gold\",\n  \"date_of_birth\": \"1998-06-20\",\n  \"date_of_anniversary\": \"2022-10-15\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/customer/signup",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "customer",
            "signup"
          ]
        }
      }
    },
    {
      "name": "Customer Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"sarah_j\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/customer/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "customer",
            "login"
          ]
        }
      }
    }
  ]
}
