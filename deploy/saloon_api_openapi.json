{
  "openapi": "3.0.0",
  "info": {
    "title": "Jugnu Saloon Public API",
    "version": "1.0.0",
    "description": "Public REST API specification for front-end integration (Products, Services, Categories, Gallery Showcase, Appointment Booking, Contact Form, Customer Signup & Login)"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/products": {
      "get": {
        "summary": "Fetch Products Catalog",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/services": {
      "get": {
        "summary": "Fetch Services Catalog",
        "parameters": [
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/service-categories": {
      "get": {
        "summary": "Fetch Service Categories",
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/galleries": {
      "get": {
        "summary": "Fetch Gallery Showcase",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful operation"
          }
        }
      }
    },
    "/api/appointments": {
      "post": {
        "summary": "Book Appointment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["customer_name", "customer_phone", "appointment_date", "start_time", "service_ids"],
                "properties": {
                  "customer_name": { "type": "string" },
                  "customer_phone": { "type": "string" },
                  "customer_email": { "type": "string" },
                  "appointment_date": { "type": "string", "format": "date" },
                  "start_time": { "type": "string" },
                  "service_ids": { "type": "array", "items": { "type": "integer" } },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Appointment created"
          },
          "422": {
            "description": "Validation error or time slot unavailable"
          }
        }
      }
    },
    "/api/contact": {
      "post": {
        "summary": "Submit Contact Form",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "email", "message"],
                "properties": {
                  "name": { "type": "string" },
                  "email": { "type": "string" },
                  "phone": { "type": "string" },
                  "subject": { "type": "string" },
                  "message": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact message submitted"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    },
    "/api/customer/signup": {
      "post": {
        "summary": "Customer Account Registration",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "phone_no1", "username", "password"],
                "properties": {
                  "name": { "type": "string" },
                  "phone_no1": { "type": "string" },
                  "username": { "type": "string" },
                  "password": { "type": "string" },
                  "father_name": { "type": "string" },
                  "address": { "type": "string" },
                  "date_of_birth": { "type": "string", "format": "date" },
                  "date_of_anniversary": { "type": "string", "format": "date" },
                  "card_type": { "type": "string", "enum": ["No Card", "Silver", "Gold", "Platinum"] },
                  "card_no": { "type": "string" },
                  "phone_no2": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer registered successfully"
          },
          "422": {
            "description": "Validation error or username taken"
          }
        }
      }
    },
    "/api/customer/login": {
      "post": {
        "summary": "Customer Login",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["password"],
                "properties": {
                  "username": { "type": "string" },
                  "login": { "type": "string" },
                  "phone_no1": { "type": "string" },
                  "password": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Customer authenticated successfully"
          },
          "401": {
            "description": "Invalid credentials"
          },
          "422": {
            "description": "Validation error"
          }
        }
      }
    }
  }
}
